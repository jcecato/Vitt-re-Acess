rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Regra Global de Segurança do Vittáre Acess™:
    // O paciente autenticado só possui permissão de leitura/escrita no seu próprio documento de prontuário
    match /patients/{patientId} {
      allow read: if request.auth != null && (request.auth.uid == patientId || resource.data.patientId == request.auth.uid);
      allow write: if request.auth != null && (request.auth.uid == patientId || resource.data.patientId == request.auth.uid);
      
      // Coleções filhas do prontuário do paciente (exames, registros de peso, relatos)
      match /{allChildren=**} {
        allow read, write: if request.auth != null && (request.auth.uid == patientId || get(/databases/$(database)/documents/patients/$(patientId)).data.patientId == request.auth.uid);
      }
    }

    // Bloqueio padrão para todas as outras coleções não especificadas
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
