rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio Global Padrão (Zero Trust - Arquitetura de Defesa em Profundidade)
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleção Principal de Pacientes (Prontuário Nutricional e Agenda)
    // - Leitura: Liberada para o aplicativo carregar consultas, agenda e dados clínicos
    // - Escrita: Bloqueada para clientes Web/Mobile. O CRM grava via Firebase Admin SDK (Service Account com bypass nativo IAM)
    match /patients/{patientId} {
      allow read: if true;
      allow write: if false;

      // Subcoleção de Avaliações e Acompanhamento de Vitalidade (Aba Meu Bem-Estar)
      // - Leitura: Liberada para visualização do histórico e Curva de Vitalidade
      // - Criação: Liberada para o paciente registrar suas respostas do questionário dos 8 eixos
      // - Alteração e Exclusão: Bloqueadas para garantir imutabilidade e integridade do histórico clínico
      match /checkins/{checkinId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      // Subcoleção de Planos Alimentares (Rotina Alimentar - CRM grava, Paciente lê)
      match /plans/{planId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Prescrições e Fórmulas (CRM grava, Paciente lê)
      match /prescriptions/{prescriptionId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
