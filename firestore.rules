rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // Bloqueio Global Padrão (Zero Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // Regra de Isolamento Determinístico do Documento do Paciente
    match /patients/{userId} {
      // Leitura permitida para o paciente proprietário autenticado (por UID ou por E-mail correspondente)
      allow read: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && (
          request.auth.token.email.lower() == userId.lower() ||
          (resource != null && resource.data.email != null && request.auth.token.email.lower() == resource.data.email.lower())
        ))
      );

      // Criação inicial permitida para o próprio usuário autenticado
      allow create: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email.lower() == userId.lower())
      );

      // Permite atualização (update) apenas de campos de consentimento/sessão do cliente,
      // impedindo que o paciente altere nós clínicos protegidos (exames, evolução, fórmulas, notas).
      allow update: if request.auth != null && (
        request.auth.uid == userId ||
        (request.auth.token.email != null && request.auth.token.email.lower() == userId.lower())
      ) && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
        'examsRequested', 'examResults', 'protocols', 'mealGuides', 'professionalNotes', 'crmGeneralNotes', 'progress'
      ]);

      // Subcoleções filhas do prontuário com leitura isolada
      match /{allChildren=**} {
        allow read: if request.auth != null && (
          request.auth.uid == userId ||
          (request.auth.token.email != null && request.auth.token.email.lower() == userId.lower())
        );
        allow write: if false;
      }
    }
  }
}
