rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // 1. Bloqueio Global Padrão (Zero Trust)
    match /{document=**} {
      allow read, write: if false;
    }

    // 2. Prontuário Nutricional e Agenda (Sincronização CRM <-> App Vittáre)
    match /patients/{patientId} {
      allow read: if true;
      allow write: if false;

      // Subcoleção de Evolução Clínica, Consultas Estruturadas e Painel Longitudinal (%)
      match /evolution/{evolutionId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção legada de Evoluções (caso exista)
      match /evolutions/{evolutionId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Avaliações e Vitalidade (Aba Meu Bem-Estar / Check-in Quinzenal)
      match /checkins/{checkinId} {
        allow read: if true;
        allow create, update: if true;
        allow delete: if false;
      }

      // Subcoleção de Planos Alimentares
      match /plans/{planId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Prescrições e Fórmulas
      match /prescriptions/{prescriptionId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Exames Laboratoriais (Hemo Labor™)
      match /exams/{examId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Avaliação Corporal (OnBody™)
      match /anthropometry/{anthroId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Avaliação Integrativa (Sense App™)
      match /anamnesis/{anamnesisId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Encaminhamento Multidisciplinar
      match /referrals/{referralId} {
        allow read: if true;
        allow write: if false;
      }

      // Garantia de leitura para qualquer subdocumento adicional do paciente
      match /{allSubcollections=**} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
