rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Bloqueio Global Padrão (Zero Trust - Arquitetura de Defesa em Profundidade)
    match /{document=**} {
      allow read, write: if false;
    }

    // Coleção Principal de Pacientes (Prontuário Nutricional e Agenda)
    // - Leitura: Liberada para o aplicativo carregar consultas, agenda e dados clínicos
    // - Escrita: Bloqueada para clientes Web/Mobile. O CRM grava via Firebase Admin SDK
    match /patients/{patientId} {
      allow read: if true;
      allow write: if false;

      // Subcoleção de Avaliações e Acompanhamento de Vitalidade (Aba Meu Bem-Estar)
      match /checkins/{checkinId} {
        allow read: if true;
        allow create: if true;
        allow update, delete: if false;
      }

      // Subcoleção de Planos Alimentares (CRM grava, Paciente lê)
      match /plans/{planId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Prescrições e Fórmulas (CRM grava, Paciente lê)
      match /prescriptions/{prescriptionId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Exames Laboratoriais (CRM grava, Paciente lê)
      match /exams/{examId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Avaliação Corporal (CRM grava, Paciente lê)
      match /anthropometry/{anthroId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Mapa Funcional (CRM grava, Paciente lê)
      match /metabolic_map/{mapId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Avaliação Integrativa (CRM grava, Paciente lê)
      match /anamnesis/{anamnesisId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Encaminhamento Multidisciplinar (CRM grava, Paciente lê)
      match /referrals/{referralId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção dedicada de Resumo Geral da Evolução (CRM grava resumo_geral, Paciente lê)
      match /evolution/{evolutionId} {
        allow read: if true;
        allow write: if false;
      }

      // Subcoleção de Evoluções Clínicas / Anotações (CRM grava, Paciente lê)
      match /evolutions/{evolutionId} {
        allow read: if true;
        allow write: if false;
      }
    }
  }
}
